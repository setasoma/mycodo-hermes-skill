# Mycodo sensor credentials — copy to ~/.mycodo/sensor-creds.env
# chmod 600 this file after editing
# See README.md for where to find each value

PI_HOST="YOUR_PI_IP_OR_HOSTNAME"
MYCODO_API_KEY="your-mycodo-api-key-here"
INFLUX_TOKEN="your-influxdb-token-here"
INFLUX_ORG="your-influx-org"
INFLUX_BUCKET="your-influx-bucket"
SHT45_ID="your-sht45-device-uuid"
SCD41_ID="your-scd41-device-uuid"
FAE_FAN_ID="your-fan-output-uuid"
HUMIDIFIER_RELAY_ID="your-humidifier-output-uuid"
