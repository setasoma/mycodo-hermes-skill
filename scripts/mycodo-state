#!/bin/bash
# mycodo-state — Canonical tent state manager
# Part of mycodo-hermes-skill
# Usage:
#   mycodo-state status              — Show current tent state
#   mycodo-state activate <spec> <phase>  — Activate a grow cycle
#   mycodo-state deactivate          — Deactivate (safety lock ON)
#   mycodo-state lock                — Emergency lock all actuators
#   mycodo-state unlock              — Release safety lock (ACTIVE grow only)
#   mycodo-state edit                — Open state file in $EDITOR

set -euo pipefail

STATE_FILE="$HOME/.mycodo-skill-tent-state.json"

# Create default state if missing
default_state() {
    cat <<'JSON'
{
  "schema_version": "1.0",
  "updated_at": "auto-generated",
  "updated_by": "mycodo-state CLI",
  "status": "inactive",
  "current_phase": "inactive",
  "species": "lions_mane",
  "safety_lock": true,
  "autonomy_level": "locked",
  "actuators": {
    "fan": {"allowed": false, "reason": "Default state", "until": "operator_releases"},
    "humidifier": {"allowed": false, "reason": "Default state", "until": "operator_releases"}
  },
  "next_phase_change": null,
  "operator_notes": "Tent state auto-generated by mycodo-state CLI."
}
JSON
}

show_state() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE" | python3 -m json.tool 2>/dev/null || cat "$STATE_FILE"
    else
        echo "No state file found at $STATE_FILE"
        echo "Run 'mycodo-state activate <species> <phase>' or 'mycodo-state deactivate' to create one."
        exit 1
    fi
}

write_state() {
    local tmp
    tmp=$(mktemp)
    cat > "$tmp"
    mv "$tmp" "$STATE_FILE"
    echo "Tent state updated: $STATE_FILE"
}

cmd="${1:-status}"
shift || true

case "$cmd" in
    status)
        show_state
        ;;

    activate)
        species="${1:-lions_mane}"
        phase="${2:-colonization}"
        spec_label=$(echo "$species" | sed 's/_/ /g')
        now=$(date -Iseconds)
        cat <<JSON | write_state
{
  "schema_version": "1.0",
  "updated_at": "$now",
  "updated_by": "operator via mycodo-state activate",
  "status": "active",
  "current_phase": "$phase",
  "species": "$species",
  "safety_lock": false,
  "autonomy_level": "full",
  "actuators": {
    "fan": {"allowed": true, "reason": "Active grow cycle: $spec_label $phase", "until": "phase_change_or_operator"},
    "humidifier": {"allowed": true, "reason": "Active grow cycle: $spec_label $phase", "until": "phase_change_or_operator"}
  },
  "next_phase_change": null,
  "operator_notes": "Grow cycle activated. Autonomous control enabled for $spec_label in $phase phase."
}
JSON
        ;;

    deactivate)
        now=$(date -Iseconds)
        cat <<JSON | write_state
{
  "schema_version": "1.0",
  "updated_at": "$now",
  "updated_by": "operator via mycodo-state deactivate",
  "status": "inactive",
  "current_phase": "inactive",
  "species": null,
  "safety_lock": true,
  "autonomy_level": "locked",
  "actuators": {
    "fan": {"allowed": false, "reason": "Tent deactivated by operator.", "until": "operator_activates"},
    "humidifier": {"allowed": false, "reason": "Tent deactivated by operator.", "until": "operator_activates"}
  },
  "next_phase_change": null,
  "operator_notes": "Grow cycle ended. Tent cleaned, blocks removed. All actuators disabled."
}
JSON
        ;;

    lock)
        if [ -f "$STATE_FILE" ]; then
            python3 -c "
import json, sys
with open('$STATE_FILE') as f:
    d = json.load(f)
d['safety_lock'] = True
d['autonomy_level'] = 'locked'
for a in d.get('actuators', {}):
    d['actuators'][a]['allowed'] = False
    d['actuators'][a]['reason'] = 'Emergency lock by operator'
    d['actuators'][a]['until'] = 'operator_unlocks'
with open('$STATE_FILE', 'w') as f:
    json.dump(d, f, indent=2)
"
            echo "Emergency lock engaged. All actuators disabled."
        else
            echo "No state file found. Run 'mycodo-state deactivate' first."
            exit 1
        fi
        ;;

    unlock)
        if [ -f "$STATE_FILE" ]; then
            python3 -c "
import json, sys
with open('$STATE_FILE') as f:
    d = json.load(f)
if d.get('status') != 'active':
    print('ERROR: Cannot unlock while status is not active. Use \"mycodo-state activate\" first.', file=sys.stderr)
    sys.exit(1)
d['safety_lock'] = False
d['autonomy_level'] = 'full'
for a in d.get('actuators', {}):
    d['actuators'][a]['allowed'] = True
    d['actuators'][a]['reason'] = 'Unlocked by operator'
    d['actuators'][a]['until'] = 'phase_change_or_operator'
with open('$STATE_FILE', 'w') as f:
    json.dump(d, f, indent=2)
"
            echo "Safety lock released. Autonomous control enabled."
        else
            echo "No state file found. Run 'mycodo-state activate' first."
            exit 1
        fi
        ;;

    edit)
        ${EDITOR:-nano} "$STATE_FILE"
        ;;

    *)
        echo "Usage: mycodo-state {status|activate <species> <phase>|deactivate|lock|unlock|edit}"
        exit 1
        ;;
esac
